# ============================================================
# Agent Playground — environment variables
# Copy this file to ".env" and fill in your values.
# ============================================================

# ----- OpenRouter -----
# Single API key giving access to all LLMs (Anthropic, OpenAI, Google, ...).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ----- Backend -----
# Port the FastAPI server listens on.
BACKEND_PORT=8000
# Allowed CORS origin for the frontend (added to http://localhost:3000).
FRONTEND_URL=http://localhost:3000

# ----- Frontend -----
# Public URL the browser uses to reach the backend.
# Local: http://localhost:8000 — Production: your deployed backend URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ----- Supabase (optional persistence) -----
# If set, the backend persists config, settings, prompts, MCP servers and chat
# history to Supabase. If unset (or unreachable), it falls back to local JSON files.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...   # anon / publishable key
